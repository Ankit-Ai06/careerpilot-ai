# Copy this file to .env and replace every value. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/careerpilot_ai
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password
JWT_ISSUER=careerpilot-ai
JWT_SECRET=replace-with-a-random-32-plus-character-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=replace-with-your-gemini-api-key
